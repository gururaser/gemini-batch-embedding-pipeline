# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Qdrant (local Docker Compose default)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Collection name
QDRANT_COLLECTION=hm_products

# Data directories (relative to project root)
DATA_DIR=data

# Pipeline tuning — calibrate after first 3 shards
RECORDS_PER_SHARD=100
MAX_CONCURRENT_JOBS=9
MAX_ENQUEUED_TOKENS=432000

# Image download concurrency
IMAGE_DOWNLOAD_CONCURRENCY=32
IMAGE_MAX_SIDE_PX=512

# Embedding output dimensionality (Matryoshka: 128–3072)
EMBEDDING_DIM=1536
